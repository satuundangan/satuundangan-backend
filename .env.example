# GA4 read-only admin reporting. Configure on the server only.
# Enable Google Analytics Data API in the Cloud project and grant this service
# account Viewer access to the intended GA4 property. This is the numeric
# property ID, not the public G-... measurement ID.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
# PEM key; escaped newline sequences are accepted. Never put this in VITE_*.
GA4_PRIVATE_KEY=

# Event-watch: daily 08:00 WIB WhatsApp digest of customer weddings at H-7/H-1/Hari-H.
# Only 'true' enables the cron (keep unset/false on dev & local).
EVENT_WATCH_ENABLED=false
# Founder WhatsApp numbers, comma-separated, international digits (e.g. 62812xxxxxxx,62813xxxxxxx).
FOUNDER_WA_NUMBERS=
# Email fallback when WhatsApp is not connected or a send fails, comma-separated.
OPS_ALERT_EMAILS=
# Extra owners to ignore (tester accounts). Entry without @ = exact email local-part, with @ = full email.
# Default when unset: undangdongofficial
EVENT_WATCH_EXCLUDE_EMAILS=undangdongofficial
