# GA4 read-only admin reporting. Configure on the server only.
# Enable Google Analytics Data API in the Cloud project and grant this service
# account Viewer access to the intended GA4 property. This is the numeric
# property ID, not the public G-... measurement ID.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
# PEM key; escaped newline sequences are accepted. Never put this in VITE_*.
GA4_PRIVATE_KEY=
